# 微信小游戏运行时 = 纯构建产物目录（源 = scripts/wechat-runtime/** +
# public/web-preview + public/engine），由 scripts/build-wechat-runtime.mjs
# 一次全量再生，不入库（与 public/engine/ 同一 doctrine）
public/exports/wechat/runtime/
# 微信 Worker 胶水中间产物（构建期按后端拼装，同属纯构建产物）
public/exports/wechat/.worker-build/

