# 外部资产单一事实源：字节级原样（构建期 verbatim 拷入 public/engine），禁止 Git eol 转换
src/runtime/extra/** -text
# 生成文件：生成器写 LF，避免 autocrlf 造成的行尾幻影改动（常态性 M 零实体 diff）
src/generated/** text eol=lf
public/licenses/** text eol=lf
# 文档一律 LF：autocrlf checkout 出 CRLF 会让 skills:check 的 frontmatter 正则失配（已两次复发）
*.md text eol=lf
# 提交门禁钩子是 shell 脚本：必须 LF（CRLF 的 shebang 在 POSIX sh 下直接失效）
.githooks/** text eol=lf
